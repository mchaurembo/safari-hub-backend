APP_NAME="CHAPA Group"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.chapa.it.com
FORCE_HTTPS=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Cloudways MySQL — chukua kutoka Application Management → Access Details
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_db_name
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@chapa.it.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REDIRECT_TO=
# Resend: usitumie onboarding@resend.dev kwenye production.
# Thibitisha domain (chapa.it.com) kisha weka MAIL_FROM_ADDRESS ya domain hiyo.
